<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="48dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="相册查看"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:text="粘贴相册链接或输入链接码，即可查看共享的照片"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_link"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:hint="例如：https://…/6e2521bfdfc7c0a0… 或链接码 6e2521bf"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri|textVisiblePassword"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.screenshare.albumviewer.GlowButtonView
            android:id="@+id/btn_open"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:contentDescription="打开相册" />

        <TextView
            android:id="@+id/tv_device_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            android:text="—— 远程相册同步 ——"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_device_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:hint="输入对方设备码，如 6E25 21BF"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textVisiblePassword"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.screenshare.albumviewer.GlowButtonView
            android:id="@+id/btn_connect_device"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:contentDescription="连接设备触发同步" />

        <TextView
            android:id="@+id/tv_connect_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/primary_red"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            android:text="长按缩略图可保存图片到手机"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@android:color/transparent"
            android:text="检测更新"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:minWidth="96dp" />
    </LinearLayout>

    <include layout="@layout/layout_album" />

</FrameLayout>
