<?xml version="1.0" encoding="utf-8"?>
<!-- 个人资料页：昵称 + 好友码修改 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101018"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="‹ 返回"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="个人资料"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 昵称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="昵称"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#80FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_liquid_input"
            android:hint="2-20 个字符"
            android:inputType="textPersonName"
            android:maxLength="20"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#55FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvNicknameHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:text="昵称是登录标识，修改后需用新昵称登录"
            android:textColor="#55FFFFFF"
            android:textSize="11sp" />

        <!-- 好友码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="好友码"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#80FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFriendCode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_liquid_input"
            android:hint="6 位字母或数字"
            android:inputType="textCapCharacters"
            android:maxLength="6"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#55FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:text="好友码全局唯一；修改后他人用旧码发来的邀请将自动失效"
            android:textColor="#55FFFFFF"
            android:textSize="11sp" />

        <!-- 保存 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_liquid_btn"
            android:text="保存修改"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
