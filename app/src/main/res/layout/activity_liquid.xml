<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃主界面（对应 HTML 原型「共享屏界」）：深紫渐变背景 + 漂浮光斑 + 玻璃卡片 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_root"
    android:fitsSystemWindows="true">

    <!-- 光斑层（6 个彩色模糊圆盘，代码添加 + 平移动画） -->
    <FrameLayout
        android:id="@+id/flBlobs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <!-- 内容区：承载首页 / 好友 / 设置三个 Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== 底部毛玻璃导航 ===== -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:padding="10dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_liquid_tab"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/bg_liquid_tab_item"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_liquid_home"
                app:tint="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="首页"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/bg_liquid_tab_item"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_liquid_users"
                app:tint="#99FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="好友"
                android:textSize="10sp"
                android:textColor="#99FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/bg_liquid_tab_item"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_liquid_settings"
                app:tint="#99FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="设置"
                android:textSize="10sp"
                android:textColor="#99FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- toast -->
    <TextView
        android:id="@+id/tvToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:maxWidth="280dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_liquid_toast"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />
</FrameLayout>
