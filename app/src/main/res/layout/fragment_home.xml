<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃首页内容：顶部栏 + 三张玻璃卡片（从 activity_liquid 拆出，由 HomeFragment 承载） -->
    <androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="120dp">

            <!-- ===== 顶部栏 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_liquid_logo">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart_fill"
                            app:tint="#FFFFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="共享屏界"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFFFF"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="和TA的专属共享空间"
                            android:textSize="12sp"
                            android:textColor="#B3FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:background="@drawable/bg_liquid_pill"
                    android:text="检查更新"
                    android:textSize="13sp"
                    android:textColor="#D9FFFFFF"
                    android:drawableStart="@drawable/ic_liquid_refresh"
                    android:drawablePadding="6dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ===== 卡片1：创建 / 加入 ===== -->
            <LinearLayout
                android:id="@+id/cardJoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_liquid_card"
                android:elevation="8dp">

                <FrameLayout
                    android:id="@+id/btnCreate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_liquid_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_liquid_plus"
                            app:tint="#FFFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="创建房间"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFFFF"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 分隔线 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_divider_line" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="或输入房间号"
                        android:textSize="13sp"
                        android:textColor="#B3FFFFFF" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_divider_line" />
                </LinearLayout>

                <!-- 4 位数字输入 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCode0"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_code_box"
                        android:inputType="number"
                        android:maxLength="1"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:textCursorDrawable="@drawable/cursor_liquid"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:hint="0"
                        android:textColorHint="#99FFFFFF" />

                    <EditText
                        android:id="@+id/etCode1"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_code_box"
                        android:inputType="number"
                        android:maxLength="1"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:textCursorDrawable="@drawable/cursor_liquid"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:hint="0"
                        android:textColorHint="#99FFFFFF" />

                    <EditText
                        android:id="@+id/etCode2"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_code_box"
                        android:inputType="number"
                        android:maxLength="1"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:textCursorDrawable="@drawable/cursor_liquid"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:hint="0"
                        android:textColorHint="#99FFFFFF" />

                    <EditText
                        android:id="@+id/etCode3"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_code_box"
                        android:inputType="number"
                        android:maxLength="1"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:textCursorDrawable="@drawable/cursor_liquid"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:hint="0"
                        android:textColorHint="#99FFFFFF" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnJoin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_liquid_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_liquid_login"
                            app:tint="#FFFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="加入会议"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFFFF"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- ===== 卡片2：专属房间 ===== -->
            <LinearLayout
                android:id="@+id/cardRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_liquid_card"
                android:elevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_heart_fill"
                            app:tint="#FFFF6BB5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="我们的专属房间"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvSwitchRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="换角色"
                            android:textSize="13sp"
                            android:textColor="#BFFFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textSize="13sp"
                            android:alpha="0.3"
                            android:textColor="#BFFFFFFF" />

                        <TextView
                            android:id="@+id/tvChangeRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="换一个"
                            android:textSize="13sp"
                            android:textColor="#BFFFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/dot_offline" />

                    <TextView
                        android:id="@+id/tvRoomNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1314"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRoomStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你是观看方（你看TA的屏幕）· 对方不在线"
                    android:textSize="13sp"
                    android:textColor="#B3FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnCopy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:background="@drawable/bg_liquid_pill"
                        android:text="复制房间号"
                        android:textSize="12sp"
                        android:textColor="#B3FFFFFF"
                        android:drawableStart="@drawable/ic_liquid_copy"
                        android:drawablePadding="5dp"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnCallTa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:background="@drawable/bg_liquid_outline"
                        android:text="喊TA"
                        android:textSize="13sp"
                        android:textColor="#FFFFFFFF"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 卡片3：最近会议 ===== -->
            <LinearLayout
                android:id="@+id/cardRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_liquid_card"
                android:elevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近会议"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/btnClearRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="清空"
                        android:textSize="13sp"
                        android:textColor="#A6FFFFFF"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 空态（对应 .empty-state）：列表为空时显示 -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_liquid_pill">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_liquid_clock"
                            app:tint="#99FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="暂无会议记录"
                        android:textSize="14sp"
                        android:textColor="#80FFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="创建房间后会显示在这里"
                        android:textSize="12sp"
                        android:textColor="#59FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
