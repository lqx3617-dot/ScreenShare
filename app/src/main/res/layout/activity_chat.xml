<?xml version="1.0" encoding="utf-8"?>
<!-- 好友聊天页：顶栏（返回 + 对方信息 + 发起共享）+ 消息列表 + 输入栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="返回"
            android:clickable="true"
            android:focusable="true" />

        <!-- 头像 -->
        <FrameLayout
            android:id="@+id/avatarBox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_avatar_pink">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="友"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>

        <!-- 昵称 + 在线状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="好友"
                android:maxEms="10"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/tvPeerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="在线"
                android:textSize="11sp"
                android:textColor="#FF34D399" />
        </LinearLayout>

        <!-- 发起共享 -->
        <TextView
            android:id="@+id/btnStartShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_friend_action"
            android:text="发起共享"
            android:textSize="12.5sp"
            android:textColor="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginBottom="4dp"
        android:background="#1FD98AA6" />

    <!-- 消息列表（stackFromEnd：从底部开始展示，新消息自动滚动到底） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:overScrollMode="ifContentScrolls" />

    <!-- 输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:maxHeight="110dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_chat_input"
            android:hint="说点什么…"
            android:textColorHint="#88FFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_friend_action"
            android:text="发送"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
