<?xml version="1.0" encoding="utf-8"?>
<!-- 好友页：顶部栏 + 搜索栏 + 空态（背景渐变/光斑/tab 栏由 LiquidHomeActivity 统一提供）
     v1.305: 清除假数据，无好友时显示空态引导 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="120dp">

        <!-- ===== 顶部栏：粗体大标题 + 添加好友 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="好友"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:letterSpacing="0.02" />

            <!-- 添加好友：圆角方块毛玻璃 -->
            <FrameLayout
                android:id="@+id/btnAddFriend"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_liquid_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_liquid_plus"
                    app:tint="#FFFFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== 搜索栏 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:background="@drawable/bg_friend_search">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="9dp"
                android:src="@drawable/ic_liquid_search"
                app:tint="#99FFFFFF" />

            <EditText
                android:id="@+id/etSearchFriend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="搜索好友昵称/房间号"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ===== 待处理好友申请（无申请时隐藏） ===== -->
        <LinearLayout
            android:id="@+id/layoutRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:text="待处理申请"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#B3FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- ===== 好友列表 ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

        <!-- ===== 空态：无好友引导 ===== -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="44dp"
            android:paddingBottom="44dp"
            android:background="@drawable/bg_card"
            android:visibility="gone">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_liquid_plus"
                app:tint="#80FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有好友"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E6FFFFFF"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="点击右上角 + 添加好友\n或直接输入房间号发起共享"
                android:textSize="13sp"
                android:textColor="#99FFFFFF"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
