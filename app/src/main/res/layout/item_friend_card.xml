<?xml version="1.0" encoding="utf-8"?>
<!-- 好友卡片（在线/离线通用）：头像 + 在线状态点 + 昵称 + 状态文字 + 发起共享按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_card"
    android:elevation="4dp">

    <!-- 头像（代码切换粉/紫/青渐变 + 白色首字；右下角状态点） -->
    <FrameLayout
        android:id="@+id/avatarBox"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_avatar_pink">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="小"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <View
            android:id="@+id/viewDot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-1dp"
            android:layout_marginBottom="-1dp"
            android:background="@drawable/bg_dot_online" />
    </FrameLayout>

    <!-- 昵称 + 状态行 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFriendName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小甜心"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_dot_online" />

            <TextView
                android:id="@+id/tvFriendStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在线"
                android:textSize="11.5sp"
                android:textColor="#FF34D399" />
        </LinearLayout>
    </LinearLayout>

    <!-- 发起共享小按钮 -->
    <TextView
        android:id="@+id/btnStartShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_friend_action"
        android:text="发起共享"
        android:textSize="12.5sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
