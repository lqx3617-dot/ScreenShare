<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="0dp"
            android:paddingBottom="28dp">

            <!-- 操作卡片（液态玻璃） -->
            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="6dp"
                android:background="@drawable/bg_glass">

                <Button
                    android:id="@+id/btnCreateRoom"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                android:text="创建房间"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_neon_cyan"
                android:textColor="#FFFFFFFF" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_neon"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加入会议"
                    android:textSize="13sp"
                    android:textColor="@color/neon_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etMeetingCode"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_cyan"
                    android:textColorHint="#3364748B"
                    android:hint="0000"
                    android:inputType="number"
                    android:maxLength="4"
                    android:letterSpacing="0.3"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btnJoinMeeting"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                android:text="加入会议"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_neon_violet"
                android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <!-- 专属房间（情侣快捷入口：固定房间号，一键进入） -->
            <LinearLayout
                android:id="@+id/llFavorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="4dp"
                android:background="@drawable/bg_glass">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❤️ 我们的专属房间"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_blue" />

                    <TextView
                        android:id="@+id/btnFavReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="换一个"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llFavBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvFavCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_cyan"
                        android:letterSpacing="0.2" />

                    <TextView
                        android:id="@+id/tvFavHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="点击设置"
                        android:textSize="12sp"
                        android:textColor="#64748B" />
                </LinearLayout>
            </LinearLayout>

            <!-- 最近会议（有历史记录时显示，点击快速加入/创建） -->
            <LinearLayout
                android:id="@+id/llRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="4dp"
                android:background="@drawable/bg_glass"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近会议"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_blue" />

                    <TextView
                        android:id="@+id/btnClearRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清空"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

    <!-- 顶部头部条：左上角小 logo + 品牌名与介绍，右上角检查更新（固定不随滚动） -->
    <LinearLayout
        android:id="@+id/llBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_brand_bar"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_brand_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="随时随地，一键共享你的屏幕"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查更新"
            android:textSize="14sp"
            android:textColor="@color/neon_cyan"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</FrameLayout>
