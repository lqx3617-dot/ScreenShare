<?xml version="1.0" encoding="utf-8"?>
<!--
  首页（v1.252 简洁重设计）
  原则：去掉外发光与常驻光斑，视觉只给「状态」与「主操作」。
  结构：品牌头（固定） → 主操作卡（创建/加入） → 专属房间 → 最近会议
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="0dp"
            android:paddingBottom="32dp">

            <!-- 顶部留白，让品牌头不压内容 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="76dp" />

            <!-- 主操作卡 -->
            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="共享屏幕，即刻开始"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="创建房间共享，或输入 4 位会议号加入"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnCreateRoom"
                    style="@style/BtnRounded"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="创建房间"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:stateListAnimator="@null"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加入会议"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etMeetingCode"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#47A7969F"
                    android:hint="0000"
                    android:inputType="number"
                    android:maxLength="4"
                    android:letterSpacing="0.3"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btnJoinMeeting"
                    style="@style/BtnRounded"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="加入会议"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- 专属房间（情侣快捷入口：固定房间号，一键进入） -->
            <LinearLayout
                android:id="@+id/llFavorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我们的专属房间"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/btnFavSwap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="换角色"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnFavReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="换一个"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llFavBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/favStatusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/dot_status"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvFavCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未设置"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/neon_cyan"
                                android:letterSpacing="0.2" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFavHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击设置"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnFavCall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="喊TA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_accent"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 最近会议（有历史记录时显示，点击快速加入/创建） -->
            <LinearLayout
                android:id="@+id/llRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近会议"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/btnClearRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清空"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

    <!-- 品牌头部条：左上角小 logo + 品牌名与介绍，右上角检查更新（固定不随滚动） -->
    <LinearLayout
        android:id="@+id/llBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_brand_bar"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_brand_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="和 TA 的专属共享空间"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查更新"
            android:textSize="14sp"
            android:textColor="@color/neon_cyan"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</FrameLayout>
