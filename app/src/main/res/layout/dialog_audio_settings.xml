<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.259 音频设置对话框：剧情音/对讲音双路独立音量 + 说话自动闪避。
  场景：情侣一起看时，剧情音（共享画面里的声音）与对讲音（对方说话）混在一起，
  系统音量键只能整体调，这里按路分别调，并在对方说话时自动压低剧情音。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="音频设置"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- 剧情音：观看方=共享画面里声音的播放音量；共享方=本机媒体音量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="剧情音"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvMediaVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_rose" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbMediaVol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="100" />

    <!-- 对讲音：对方说话的声音 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="对讲音"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvTalkVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_rose" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbTalkVol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="100" />

    <!-- 自动闪避：对方说话时压低剧情音 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="对方说话时自动压低剧情音"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDuck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="设置仅在本端生效。剧情音=共享画面里的声音，对讲音=对方说话的声音。"
        android:textSize="11sp"
        android:textColor="#FF8A7E88"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
