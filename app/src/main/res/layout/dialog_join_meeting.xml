<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minWidth="300dp"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="加入会议"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入会议创建方提供的 4 位会议号"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/etMeetingCode"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="@color/neon_cyan"
        android:textColorHint="#3364748B"
        android:hint="0000"
        android:inputType="number"
        android:maxLength="4"
        android:letterSpacing="0.3"
        android:imeOptions="actionDone"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="会议口令（创建方分享链接中附带）"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etMeetingToken"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/neon_cyan"
        android:textColorHint="#3364748B"
        android:hint="XXXX-XXXX"
        android:inputType="text"
        android:maxLength="8"
        android:letterSpacing="0.3"
        android:imeOptions="actionDone"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/btnJoinSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="加入"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#FF0A0D26"
        android:background="@drawable/bg_btn_neon_violet" />

    <TextView
        android:id="@+id/btnJoinCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="取消"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
