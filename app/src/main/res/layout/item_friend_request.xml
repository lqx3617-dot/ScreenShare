<?xml version="1.0" encoding="utf-8"?>
<!-- 好友申请卡片：头像 + 昵称 + 接受/拒绝 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_card"
    android:elevation="4dp">

    <FrameLayout
        android:id="@+id/avatarBox"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_avatar_pink">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvRequestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="申请昵称"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/btnAccept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_liquid_btn"
        android:text="接受"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btnReject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_friend_action"
        android:text="拒绝"
        android:textSize="12.5sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground" />
</LinearLayout>
