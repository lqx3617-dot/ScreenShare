<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天气泡（左右通用）：FrameLayout 内两侧各一个头像位（layout_gravity 定位），
     气泡左右由代码设 gravity + margin（给可见头像留出空间） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- 对方头像（固定左端） -->
    <FrameLayout
        android:id="@+id/avatarStart"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_avatar_pink"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAvatarStartInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="友"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="270dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="7dp"
        android:background="@drawable/bg_chat_bubble_other">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="消息内容"
            android:textSize="14.5sp"
            android:textColor="#FFFFFFFF"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="时间"
            android:textSize="10.5sp"
            android:textColor="#88FFFFFF" />
    </LinearLayout>

    <!-- 我的头像（固定右端） -->
    <FrameLayout
        android:id="@+id/avatarEnd"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_avatar_pink"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAvatarEndInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="我"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>
</FrameLayout>
