<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_root">

    <!-- 远程画面（观看方）：铺满整个屏幕，画面最大化 -->
    <FrameLayout
        android:id="@+id/flRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black"
        android:clipChildren="false">
    </FrameLayout>

    <!-- 顶部状态胶囊：会议状态（连接/共享/视频通话状态） -->
    <LinearLayout
        android:id="@+id/llStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_status_pill_dark"
        android:elevation="12dp"
        android:visibility="gone">

        <View
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_status"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备就绪"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- 视频控制提示 -->
    <TextView
        android:id="@+id/tvZoomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="双指捏合可缩放画面"
        android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:padding="6dp" />

    <!-- 共享方远程控制状态（仅共享方显示），悬浮于底部工具条上方 -->
    <LinearLayout
        android:id="@+id/llCtrlStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_panel_btn_dark"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCtrlStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="远程控制状态"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/btnCtrlSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去开启"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/success_light"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCtrlLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="停止控制"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFC107"
            android:paddingStart="10dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- 会议号提示 / 诊断信息（悬浮于底部工具条上方） -->
    <TextView
        android:id="@+id/tvScanResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="gone"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="172dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_panel_btn_dark" />

    <!-- 底部悬浮工具条：图标在上文字在下的瓦片式按钮（现代通话 UI），weight 均分适配窄屏 -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_toolbar_dark"
        android:elevation="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="麦克风"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:drawableTop="@drawable/ic_mic"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_room_tile" />

        <TextView
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="摄像头"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:drawableTop="@drawable/ic_videocam"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_room_tile" />

        <!-- v1.259: 音量入口提到工具条常驻（麦克风/剧情音分别调节 + 说话闪避） -->
        <TextView
            android:id="@+id/btnAudioSettings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="音量"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:drawableTop="@drawable/ic_volume"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_room_tile" />

        <TextView
            android:id="@+id/btnWatchTogether"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="一起看"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:drawableTop="@drawable/ic_play_badge"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_room_tile" />

        <TextView
            android:id="@+id/btnToolbarMore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="更多"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:drawableTop="@drawable/ic_more_horiz"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_room_tile" />

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="结束会议"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:drawableTop="@drawable/ic_call_end"
            android:drawablePadding="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_btn_neon_red" />
    </LinearLayout>

        <!-- 更多面板：收纳次要功能（原视频框内悬浮按钮 + fps/拍照/检查更新） -->
        <LinearLayout
            android:id="@+id/llMorePanel"
            android:layout_width="wrap_content"
            android:minWidth="76dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="104dp"
            android:padding="12dp"
            android:background="@drawable/bg_toolbar_dark"
            android:elevation="24dp"
            android:visibility="gone">

            <!-- 左列：远程控制与功能扩展 -->
            <LinearLayout
                android:id="@+id/llVideoBtns"
                android:layout_width="wrap_content"
                android:minWidth="76dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/btnRemoteControl"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:text="远程控制"
                android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llCtrlKeys"
                    android:layout_width="wrap_content"
                    android:minWidth="76dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_panel_btn_dark"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnCtrlBack"
                        style="@style/PanelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="← 返回" />
                    <TextView
                        android:id="@+id/btnCtrlHome"
                        style="@style/PanelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="⌂ 主页" />
                    <TextView
                        android:id="@+id/btnCtrlRecents"
                        style="@style/PanelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="▤ 最近" />
                </LinearLayout>

            <TextView
                android:id="@+id/btnCtrlText"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="文本"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnCtrlPoke"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="戳TA"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnCtrlMark"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="标注"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnAlbum"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="相册"
                android:visibility="gone" />
            </LinearLayout>

            <!-- 中列：画面与帧率 -->
            <LinearLayout
                android:id="@+id/llRemoteRight"
                android:layout_width="wrap_content"
                android:minWidth="76dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/btnAspectToggle"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:text="完整"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnFullscreen"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⛶ 全屏"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnFpsToggle"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="高帧率"
                android:visibility="gone" />
            </LinearLayout>

            <!-- 右列：实用工具与品牌 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:minWidth="76dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/btnCameraCapture"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:text="拍照"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnPip"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="小窗" />
            <TextView
                android:id="@+id/tvCheckUpdate"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="检查更新" />
            <TextView
                android:id="@+id/btnExportLog"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="导出日志" />
            <TextView
                android:id="@+id/tvTitleBrand"
                style="@style/PanelButton.Brand"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name" />
            </LinearLayout>

            <!-- 第四列：视频通话增强（仅视频通话中可见） -->
            <LinearLayout
                android:id="@+id/llCallExtras"
                android:layout_width="wrap_content"
                android:minWidth="76dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/btnFlipCamera"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:text="切换前后摄"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnHidePip"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="隐藏对方画面"
                android:visibility="gone" />
                <TextView
                    android:id="@+id/tvTalkIndicator"
                    style="@style/PanelButton"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:foreground="@null"
                    android:text="对讲待机"
                    android:visibility="gone" />
            <TextView
                android:id="@+id/btnCamQuality"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="画质 480P"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnLocalPreview"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="本端预览 开"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnBrightness"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="亮度"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnMirror"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="镜面 关"
                android:visibility="gone" />
            </LinearLayout>


    </LinearLayout>

    <!-- 视频通话 PIP 小窗：显示对方摄像头人脸（host 与 viewer 通用，浮在右上角） -->
    <FrameLayout
        android:id="@+id/flCameraPip"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_video_frame"
        android:elevation="30dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvCameraPipHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="对方摄像头"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
            android:background="@color/scrim_strong" />
        <!-- 对方画面亮度遮罩：跟随亮度调节，纯显示层不改变视频流 -->
        <View
            android:id="@+id/vCameraPipBrightness"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:clickable="false"
            android:visibility="invisible" />
          <!-- 视频通话网络状态灯：右下角 8dp 圆点，正常绿/弱网琥珀，无视频轨隐藏 -->
          <View
              android:id="@+id/vNetDot"
              android:layout_width="8dp"
              android:layout_height="8dp"
              android:layout_gravity="bottom|end"
              android:layout_marginEnd="6dp"
              android:layout_marginBottom="6dp"
              android:background="@drawable/bg_net_dot"
              android:clickable="false"
              android:visibility="gone" />
    </FrameLayout>

    <!-- 视频通话本端预览小窗：显示自己摄像头画面（确认对方看到的内容），浮在左下角 -->
    <FrameLayout
        android:id="@+id/flLocalPreview"
        android:layout_width="100dp"
        android:layout_height="133dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_video_frame"
        android:elevation="30dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvLocalPreviewHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="本端预览"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
            android:background="@color/scrim_strong" />
        <!-- 本端预览亮度遮罩：跟随亮度调节 -->
        <View
            android:id="@+id/vLocalPreviewBrightness"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:clickable="false"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 全屏叠加层：在 FrameLayout 最外层，覆盖所有内容 -->
    <FrameLayout
        android:id="@+id/flFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black"
        android:elevation="10dp">
        <TextView
            android:id="@+id/btnExitFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text="退出全屏"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_panel_btn_dark" />

        <TextView
            android:id="@+id/tvFullscreenStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/neon_cyan"
            android:typeface="monospace"
            android:background="@drawable/bg_panel_btn_dark" />
    </FrameLayout>

    <!-- 相册查看（主 App 内直接看全部照片，无需链接）：WebView 加载聚合相册页 -->
    <FrameLayout
        android:id="@+id/flAlbumViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black"
        android:elevation="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF1A1A1A"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:elevation="5dp">

            <TextView
                android:id="@+id/tvAlbumViewerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="相册 · 全部照片"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

            <TextView
                android:id="@+id/btnCloseAlbumViewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center"
                android:text="关闭"
                android:textSize="14sp"
                android:textColor="@color/success_light" />
        </LinearLayout>

        <!-- WebView 动态添加到此容器（代码创建，避免 XML 强依赖 WebView 尺寸） -->
        <FrameLayout
            android:id="@+id/flAlbumWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="46dp" />
    </FrameLayout>

    <!-- 爱心迸发层：连接成功时从屏幕下方飘起一串玫瑰爱心（纯展示，不拦截触摸） -->
    <FrameLayout
        android:id="@+id/flHeartBurst"
        android:layout_width="match_parent"
