<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- 远程画面（观看方）：铺满整个屏幕，画面最大化 -->
    <FrameLayout
        android:id="@+id/flRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FF000000"
        android:clipChildren="false">
    </FrameLayout>

    <!-- 顶部状态胶囊：会议状态（连接/共享/视频通话状态） -->
    <LinearLayout
        android:id="@+id/llStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_glass"
        android:elevation="10dp"
        android:visibility="gone">

        <View
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_status"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备就绪"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 视频控制提示 -->
    <TextView
        android:id="@+id/tvZoomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="双指捏合可缩放画面"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:padding="6dp" />

    <!-- 共享方远程控制状态（仅共享方显示），悬浮于底部工具条上方 -->
    <LinearLayout
        android:id="@+id/llCtrlStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_fullscreen_btn"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCtrlStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="远程控制状态"
            android:textSize="12sp"
            android:textColor="#FF1E293B" />

        <TextView
            android:id="@+id/btnCtrlSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去开启"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF7CFC9C"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCtrlLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="停止控制"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFC107"
            android:paddingStart="10dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- 会议号提示 / 诊断信息（悬浮于底部工具条上方） -->
    <TextView
        android:id="@+id/tvScanResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:visibility="gone"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="172dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_fullscreen_btn" />

    <!-- 底部悬浮工具条：3 核心 + 更多（match_parent + weight 均分，适配窄屏不超宽） -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_glass"
        android:elevation="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="麦克风"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF1E293B"
            android:drawableStart="@drawable/ic_mic"
            android:drawablePadding="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_fullscreen_btn" />

        <TextView
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="摄像头"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF1E293B"
            android:drawableStart="@drawable/ic_videocam"
            android:drawablePadding="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_fullscreen_btn" />

        <TextView
            android:id="@+id/btnToolbarMore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="更多"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF1E293B"
            android:drawableStart="@drawable/ic_more_horiz"
            android:drawablePadding="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_fullscreen_btn" />

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="结束会议"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFE4E4"
            android:drawableStart="@drawable/ic_call_end"
            android:drawablePadding="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_btn_neon_red" />
    </LinearLayout>

    <!-- 更多面板：收纳次要功能（原视频框内悬浮按钮 + fps/拍照/检查更新） -->
    <LinearLayout
        android:id="@+id/llMorePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:padding="10dp"
        android:background="@drawable/bg_glass"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- 左列：视频控制（远程控制/控制键/文本/相册） -->
        <LinearLayout
            android:id="@+id/llVideoBtns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnRemoteControl"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="远程控制"
                android:textSize="12sp"
                android:textColor="#FF1E293B"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llCtrlKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnCtrlBack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="← 返回"
                    android:textSize="12sp"
                    android:textColor="#FF1E293B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/btnCtrlHome"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="⌂ 主页"
                    android:textSize="12sp"
                    android:textColor="#FF1E293B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/btnCtrlRecents"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="▤ 最近"
                    android:textSize="12sp"
                    android:textColor="#FF1E293B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCtrlText"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="文本"
                android:textSize="12sp"
                android:textColor="#FF1E293B"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAlbum"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="相册"
                android:textSize="12sp"
                android:textColor="#FF1E293B"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 中列：比例/全屏/帧率 -->
        <LinearLayout
            android:id="@+id/llRemoteRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/btnAspectToggle"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="完整"
                android:textSize="12sp"
                android:textColor="#FF1E293B"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="⛶ 全屏"
                android:textSize="12sp"
                android:textColor="#FF1E293B"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnFpsToggle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="60帧"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF1E293B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 右列：拍照/检查更新/品牌 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/btnCameraCapture"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="拍照"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF1E293B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnPip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="小窗"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF1E293B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn" />

            <TextView
                android:id="@+id/tvCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="检查更新"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF1E293B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_fullscreen_btn" />

            <TextView
                android:id="@+id/tvTitleBrand"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="ScreenShare"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 视频通话 PIP 小窗：显示对方摄像头人脸（host 与 viewer 通用，浮在右上角） -->
    <FrameLayout
        android:id="@+id/flCameraPip"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_video_frame"
        android:elevation="30dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvCameraPipHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="对方摄像头"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:background="#88000000" />
    </FrameLayout>

    <!-- 全屏叠加层：在 FrameLayout 最外层，覆盖所有内容 -->
    <FrameLayout
        android:id="@+id/flFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FF000000"
        android:elevation="10dp">
        <TextView
            android:id="@+id/btnExitFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text="退出全屏"
            android:textSize="14sp"
            android:textColor="#FF1E293B"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/bg_fullscreen_btn" />

        <TextView
            android:id="@+id/tvFullscreenStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            android:text=""
            android:textSize="12sp"
            android:textColor="#FF4B8DF9"
            android:typeface="monospace"
            android:background="@drawable/bg_fullscreen_btn" />
    </FrameLayout>

    <!-- 相册查看（主 App 内直接看全部照片，无需链接）：WebView 加载聚合相册页 -->
    <FrameLayout
        android:id="@+id/flAlbumViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FF000000"
        android:elevation="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF1A1A1A"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:elevation="5dp">

            <TextView
                android:id="@+id/tvAlbumViewerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="相册 · 全部照片"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF1E293B" />

            <TextView
                android:id="@+id/btnCloseAlbumViewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center"
                android:text="关闭"
                android:textSize="14sp"
                android:textColor="#FF7CFC9C" />
        </LinearLayout>

        <!-- WebView 动态添加到此容器（代码创建，避免 XML 强依赖 WebView 尺寸） -->
        <FrameLayout
            android:id="@+id/flAlbumWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="46dp" />
    </FrameLayout>

</FrameLayout>
