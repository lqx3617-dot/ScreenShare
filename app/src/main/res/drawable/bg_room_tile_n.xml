<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃圆钮常态：深紫半透明 + 圆角 20 + 描边 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部高光 -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="0dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- 深紫玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#E62E1B46"
                android:centerColor="#E03C2670"
                android:endColor="#DB483083" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
