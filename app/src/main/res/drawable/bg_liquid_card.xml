<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃卡片（v1.375 重塑）
  原版：白→淡紫→白 彩色渐变描边 + 20% 半透明白主体。彩色描边在深紫底上显杂，
  且与主按钮的紫粉渐变抢视觉。改为一套语言：单色细描边 + 分层玻璃主体 + 顶部高光。
  深色玻璃的"高级感"来自克制的层次，不来自颜色。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主体：分层玻璃（上亮下沉，模拟光从上方打下来） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#3DFFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#33FFFFFF" />
        </shape>
    </item>
    <!-- 描边：单色白，越细越精致 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光线：只留中间一段，暗示玻璃厚度 -->
    <item
        android:left="32dp"
        android:right="32dp"
        android:top="0dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
