<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部状态胶囊：柔和投影 + 白玻璃 + 顶部高光（v1.258 美化版） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和暖粉投影 -->
    <item
        android:left="1dp"
        android:top="4dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/glass_shadow_md" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="0dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:centerColor="@color/glass_highlight_mid"
                android:endColor="@color/glass_highlight_end" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="90"
                android:startColor="#FAFFFFFF"
                android:endColor="#F2FFF8FA" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_soft" />
        </shape>
    </item>
</layer-list>
