<?xml version="1.0" encoding="utf-8"?>
<!-- 会议室工具条瓦片：白玻璃圆角 18dp + 粉调描边，按下玫瑰提亮（图标在上文字在下） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#F2FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFE85D8D" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#EDFFF6F9" />
            <stroke
                android:width="1dp"
                android:color="#AAE85D8D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="#F0FFFFFF"
                android:endColor="#E8FFF7FA" />
            <stroke
                android:width="1dp"
                android:color="#24D98AA6" />
        </shape>
    </item>
</selector>
