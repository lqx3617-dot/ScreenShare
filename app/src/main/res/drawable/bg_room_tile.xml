<?xml version="1.0" encoding="utf-8"?>
<!-- 会议室工具条瓦片：柔和投影 + 白玻璃 + 顶部高光 + 粉调描边，按下玫瑰提亮（v1.258 美化版） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和暖粉投影（浮起感） -->
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_shadow_sm" />
        </shape>
    </item>
    <!-- 顶部高光（玻璃质感） -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="0dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight_strong"
                android:centerColor="@color/glass_highlight_soft"
                android:endColor="@color/glass_highlight_end" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="#F4FFFFFF"
                android:endColor="#E6FFF7FA" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_soft" />
        </shape>
    </item>
</layer-list>
