<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃控制按钮：半透明白 + 浅灰描边（浅色毛玻璃），按下加深 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F0FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FF3B82F6" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#EAFBFFFF" />
            <stroke
                android:width="1dp"
                android:color="#AA3B82F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#CCFBFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
