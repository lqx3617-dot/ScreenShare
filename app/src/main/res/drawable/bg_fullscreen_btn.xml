<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮控制按钮（简洁版 v1.252）
  房间内更多面板有 20+ 个按钮，统一用"浅底 + 细描边 + 按压提亮"，
  只让被选中的状态（帧率/画质等开关）用珊瑚色，其余一律安静。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F0FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#EDFFF6F9" />
            <stroke
                android:width="1dp"
                android:color="#AAE85D8D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#D8FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#24D98AA6" />
        </shape>
    </item>
</selector>
