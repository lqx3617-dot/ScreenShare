<?xml version="1.0" encoding="utf-8"?>
<!-- 半透明深色控制按钮：深色底 + 青色描边（全屏/控制按钮），按下时提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#E6151B2E" />
            <stroke
                android:width="2dp"
                android:color="#FF00E5FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#D9151B2E" />
            <stroke
                android:width="2dp"
                android:color="#AA00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#B3151B2E" />
            <stroke
                android:width="1dp"
                android:color="#5500E5FF" />
        </shape>
    </item>
</selector>
