<?xml version="1.0" encoding="utf-8"?>
<!-- 半透明深色控制按钮：深色底 + 柔和蓝描边（全屏/控制按钮），按下时提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#E61A2230" />
            <stroke
                android:width="2dp"
                android:color="#FF4B8DF9" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#D91A2230" />
            <stroke
                android:width="2dp"
                android:color="#AA4B8DF9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#B31A2230" />
            <stroke
                android:width="1dp"
                android:color="#2B4B8DF9" />
        </shape>
    </item>
</selector>
