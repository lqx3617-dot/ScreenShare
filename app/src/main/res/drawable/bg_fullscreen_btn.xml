<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃控制按钮：半透明白 + 粉调描边（浅色毛玻璃），按下玫瑰提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F2FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFE85D8D" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#EDFFF6F9" />
            <stroke
                android:width="1dp"
                android:color="#AAE85D8D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#CDFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
