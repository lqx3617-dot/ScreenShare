<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃卡片：柔和投影 + 半透明白玻璃 + 顶部高光 + 浅灰描边（立体浮起） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和投影 -->
    <item
        android:left="2dp"
        android:top="6dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#264B5563" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="90"
                android:startColor="#F8FFFFFF"
                android:endColor="#EFFBFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1F64748B" />
        </shape>
    </item>
</layer-list>
