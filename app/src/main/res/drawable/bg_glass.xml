<?xml version="1.0" encoding="utf-8"?>
<!-- 深色极简玻璃卡片：深灰蓝半透明渐变底 + 柔和细描边（无光晕） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="90"
        android:startColor="#CC1A2434"
        android:endColor="#CC0E131C" />
    <stroke
        android:width="1dp"
        android:color="#2A3B82F6" />
</shape>
