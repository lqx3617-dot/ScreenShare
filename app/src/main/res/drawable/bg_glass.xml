<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃卡片：柔和暖粉投影 + 半透明白玻璃 + 顶部高光 + 粉调描边（立体浮起） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和投影 -->
    <item
        android:left="2dp"
        android:top="6dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/glass_shadow_lg" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="@color/glass_highlight_mid"
                android:endColor="@color/glass_highlight_end" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="#FBFFFFFF"
                android:endColor="#F4FFF6F8" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
