<?xml version="1.0" encoding="utf-8"?>
<!-- 深蓝玻璃卡片：半透明深蓝渐变 + 顶部青色高光边 + 柔和青色描边，带层次感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部高光（青色调，宽度由上层形状裁切） -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#2E3B82F6"
                android:centerColor="#0A3B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="90"
                android:startColor="#E619243C"
                android:endColor="#E6111A2E" />
            <stroke
                android:width="1dp"
                android:color="#3A4B8DF9" />
        </shape>
    </item>
</layer-list>
