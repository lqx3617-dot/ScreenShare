<?xml version="1.0" encoding="utf-8"?>
<!-- 珊瑚渐变次按钮：珊瑚渐变，按下提亮，禁用降亮 45% -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item
                android:drawable="@drawable/bg_btn_neon_violet_n"
                android:alpha="0.45" />
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#FFFB9C86"
                android:endColor="#FFF97C6A" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_btn_neon_violet_n" />
</selector>
