<?xml version="1.0" encoding="utf-8"?>
<!-- 会议室底部工具条：柔和暖粉投影 + 白玻璃主体 + 顶部高光带（v1.258 美化版） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和投影（深度浮起） -->
    <item
        android:left="2dp"
        android:top="8dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#1EDF9BB0" />
        </shape>
    </item>
    <!-- 顶部高光带（玻璃质感） -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:top="0dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="90"
                android:startColor="#FAFFFFFF"
                android:endColor="#F0FFF6F8" />
            <stroke
                android:width="1dp"
                android:color="#2CD98AA6" />
        </shape>
    </item>
</layer-list>
