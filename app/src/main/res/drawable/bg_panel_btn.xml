<?xml version="1.0" encoding="utf-8"?>
<!-- 更多面板按钮：柔和投影 + 白玻璃 + 顶部高光，按下玫瑰提亮（v1.258 美化版） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和投影 -->
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#14DF9BB0" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="0dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#2CFFFFFF"
                android:centerColor="#0CFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#F2FFFFFF"
                android:endColor="#E4FFF7FA" />
            <stroke
                android:width="1dp"
                android:color="#26D98AA6" />
        </shape>
    </item>
</layer-list>
