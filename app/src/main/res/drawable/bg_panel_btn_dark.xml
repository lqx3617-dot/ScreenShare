<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃面板按钮：深紫半透明 + 圆角 16，按下提亮，禁用降亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:drawable="@drawable/bg_panel_btn_dark_n" android:alpha="0.45" />
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#FF4A2D78"
                android:endColor="#FF5B3083" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_panel_btn_dark_n" />
</selector>
