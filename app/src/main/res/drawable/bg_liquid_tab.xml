<?xml version="1.0" encoding="utf-8"?>
<!--
  底部导航条（v1.384 框架化）
  v1.375：深紫半透玻璃主体，整条施加背景模糊。
  v1.384：导航条退化为「框架」——主体全透，只保留细白描边与顶部高光，
  真实模糊与透镜折射移到选中 tab 上（LiquidTabBar.onGlassTarget），
  像一块玻璃在框架里滑动。Android 12 以下选中项自动降级为半透明叠层。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 框架主体：全透，背景内容直接透过 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- 描边：细白，勾勒框架边界 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光线：中间亮两头收，模拟玻璃厚度 -->
    <item
        android:left="40dp"
        android:right="40dp"
        android:top="0dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
