<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃面板按钮常态：深紫半透明 + 圆角 16 + 描边 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部高光 -->
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="0dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0CFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- 深紫玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#E62E1B46"
                android:endColor="#DB483083" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
