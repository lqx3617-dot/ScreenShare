<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框背景：聚焦时玫瑰描边加深 + 柔和投影（v1.258 美化版） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:left="1dp"
                android:top="3dp"
                android:right="1dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#14DF9BB0" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#FAFFFFFF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFE85D8D" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="1dp"
                android:top="3dp"
                android:right="1dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#10DF9BB0" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#F2FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#47E8A0BC" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
