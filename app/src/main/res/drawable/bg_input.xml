<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框（简洁版 v1.252）：细描边 + 近透明白底，去掉粉色填色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="#FAFFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="#F2FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_neon" />
        </shape>
    </item>
</selector>
