<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框背景：柔和投影 + 半透明白玻璃 + 浅灰描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="8dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2E475569" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="90"
                android:startColor="#FAFFFFFF"
                android:endColor="#F2FBFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1F64748B" />
        </shape>
    </item>
</layer-list>
