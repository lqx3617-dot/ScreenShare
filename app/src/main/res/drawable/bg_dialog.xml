<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框背景：半透明深蓝 + 顶部青色高光 + 青色描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#2E3B82F6"
                android:centerColor="#0A3B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="90"
                android:startColor="#F21E2A44"
                android:endColor="#F2111A2E" />
            <stroke
                android:width="1dp"
                android:color="#3A4B8DF9" />
        </shape>
    </item>
</layer-list>
