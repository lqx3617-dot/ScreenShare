<?xml version="1.0" encoding="utf-8"?>
<!-- 红色圆底：结束会议警示图标容器（柔和） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFD63B3B" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF1B2434" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#FFFF7A7A"
                android:endColor="#FFEF5252" />
        </shape>
    </item>
</layer-list>
