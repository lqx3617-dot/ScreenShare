<?xml version="1.0" encoding="utf-8"?>
<!-- 液态根背景 v3：高饱和夜空（用户反馈"太淡/色彩不够"）
     底层 135° 深紫黑→饱和靛蓝→饱和玫红紫；上层 315° 亮玫红→深紫（不透明收尾，色块铺满不全透明）
     angle 必须是 45 的倍数（GradientDrawable 硬性要求），原先 160 在真机 inflate 直接崩 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0C0524"
                android:centerColor="#2B1368"
                android:endColor="#5E1A6B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#9C2A6E"
                android:centerColor="#5E1A6B"
                android:endColor="#1A0A3E" />
        </shape>
    </item>
</layer-list>
