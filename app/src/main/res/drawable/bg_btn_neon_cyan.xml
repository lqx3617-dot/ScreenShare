<?xml version="1.0" encoding="utf-8"?>
<!-- 玫瑰渐变主按钮：玫瑰渐变 + 柔和高光，按下提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#FFF794B4"
                android:endColor="#FFEE7BA2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#FFEE7BA2"
                android:endColor="#FFE45C8C" />
        </shape>
    </item>
</selector>
