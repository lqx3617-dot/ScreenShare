<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃色散高光（v1.375）
  模拟 iOS 26 Liquid Glass 与 AndroidLiquidGlassView 的折射色散：
  玻璃边缘因厚度产生极淡的色散（暖玫瑰 ↔ 冷淡紫），只出现在卡片顶边，
  幅度极小（8% 透明度），是"高级感"的来源而非"彩色感"。
  叠在 bg_liquid_card 之上使用，不替换它。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶边色散：左端冷（淡紫）→ 中段高光 → 右端暖（玫瑰） -->
    <item
        android:left="24dp"
        android:right="24dp"
        android:top="0dp"
        android:height="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#148B5CF6"
                android:centerColor="#A6FFFFFF"
                android:endColor="#14E85D8D" />
        </shape>
    </item>
    <!-- 底边极弱环境光收尾（不对称才像真实玻璃，上下同亮是塑料） -->
    <item
        android:left="48dp"
        android:right="48dp"
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
