<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃药丸（v1.387 导航条重构）
  导航条框架圆角 22dp，药丸内缩 4dp、固定 16dp 圆角，二者圆角永不相交，
  从设计上消除「玻璃探出框架」的对齐问题。半透明白底 + 描边 + 顶部高光，
  叠加 LiquidGlass 的背景模糊与透镜折射后即液态玻璃观感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:left="32dp"
        android:right="32dp"
        android:top="0dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
