<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃药丸 · 降级叠层（v1.387 导航条重构，v1.416 弱化）
  导航条框架圆角 22dp，药丸内缩 4dp、固定 18dp 圆角，二者圆角永不相交，
  从设计上消除「玻璃探出框架」的对齐问题。
  v1.416：Android 13+ 的物理玻璃由 AGSL shader 渲染（折射+高光+阴影），
  本 drawable 只作低版本/装配失败的降级叠层。白底进一步压低（2E→20），
  描边减弱（4D→3F），避免半透明白底白边的塑料感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#20FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#3FFFFFFF" />
        </shape>
    </item>
    <item
        android:left="32dp"
        android:right="32dp"
        android:top="0dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
