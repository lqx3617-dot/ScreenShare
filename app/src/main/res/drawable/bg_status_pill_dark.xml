<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部状态胶囊：柔和投影 + 白玻璃 + 顶部高光（v1.258 美化版） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和暖粉投影 -->
    <item
        android:left="1dp"
        android:top="4dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="0dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="90"
                android:startColor="#E61A1216"
                android:endColor="#B3151013" />
            <stroke
                android:width="1dp"
                android:color="#2CD98AA6" />
        </shape>
    </item>
</layer-list>
