<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃状态胶囊：深紫半透明 + 圆角胶囊 + 描边 + 顶部高光（浮于视频画面之上） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部高光 -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="0dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#44FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- 深紫玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#E6331F4C"
                android:centerColor="#E03A2570"
                android:endColor="#DB483083" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
