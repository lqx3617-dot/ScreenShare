<?xml version="1.0" encoding="utf-8"?>
<!-- 深蓝卡片：深蓝渐变 + 顶部青色高光 + 柔和描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#263B82F6"
                android:centerColor="#083B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/bg_card"
                android:endColor="#FF14203A" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</layer-list>
