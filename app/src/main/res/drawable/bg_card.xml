<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃卡片：通透渐变主体 + 弱环境色描边（模拟 iOS26 玻璃边缘） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 边缘描边：上亮→中段蓝灰→品红微染→底部白，弱亮度不刺眼 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="135"
                android:startColor="#61FFFFFF"
                android:centerColor="#1AC6D2FF"
                android:endColor="#38FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃主体（内缩 1dp）：通透渐变 10%→2.5%→6%，让背后光斑色彩透出 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#0FFFFFFF" />
        </shape>
    </item>
</layer-list>
