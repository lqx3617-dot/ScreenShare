<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenShare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/neon_violet</item>
        <item name="colorSecondaryVariant">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 圆角卡片背景 -->
    <style name="CardBg" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- 主按钮圆角 -->
    <style name="BtnRounded" parent="">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 更多面板按钮：统一尺寸、字色、阴影、背景与内边距，列内首个无上间距 -->
    <style name="PanelButton">
        <item name="android:minWidth">76dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@drawable/bg_panel_btn_dark</item>
    </style>

    <!-- 更多面板品牌标识：同尺寸字色，弱化为半透明、无按钮背景 -->
    <style name="PanelButton.Brand">
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:background">@null</item>
    </style>

    <!-- 霓虹风格 AlertDialog：深色底 + 青色强调 -->
    <style name="Theme.ScreenShare.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorAccent">@color/neon_cyan</item>
        <item name="android:background">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 自定义玻璃卡片 Dialog：透明背景，居中，缩放淡入 -->
    <style name="Theme.ScreenShare.Dialog.Overlay" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@style/DialogScaleFade</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 弹窗入场动画：缩放 + 淡入 -->
    <style name="DialogScaleFade">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_fade_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_fade_out</item>
    </style>
</resources>
